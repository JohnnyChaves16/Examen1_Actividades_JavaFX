<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="examen.actividades.controller.ActividadController"
      spacing="10"
      prefWidth="650"
      prefHeight="650">

    <padding>
        <Insets top="15"
                right="15"
                bottom="15"
                left="15"/>
    </padding>

    <Label text="Gestion de Actividades"/>

    <GridPane hgap="10"
              vgap="10">

        <Label text="Codigo"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCodigo"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Nombre"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Tipo"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="cmbTipo"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="1"/>

        <Label text="Tarifa base"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtTarifaBase"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

        <Label text="Cupo total"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCupoTotal"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">

        <Button fx:id="btnRegistrar"
                text="Registrar"
                onAction="#registrar"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#limpiar"/>

        <Button fx:id="btnMostrarTodas"
                text="Mostrar todas"
                onAction="#mostrarTodas"/>

        <Button fx:id="btnGuardar"
                text="Guardar datos"
                onAction="#guardarDatos"/>

    </HBox>

    <Separator/>

    <Label text="Consulta e inscripcion"/>

    <HBox spacing="10">

        <TextField fx:id="txtCodigoConsulta"
                   promptText="Codigo de actividad"
                   onAction="#buscar"/>

        <Button fx:id="btnBuscar"
                text="Buscar"
                onAction="#buscar"/>

        <Button fx:id="btnInscribir"
                text="Inscribir"
                onAction="#inscribir"/>

    </HBox>

    <TextArea fx:id="txaResultados"
              editable="false"
              prefHeight="300"/>

    <Label fx:id="lblMensaje"/>

</VBox>
